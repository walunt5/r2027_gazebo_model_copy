<?xml version="1.0"?>
<!-- Rule V3, section 2.11 and appendix 1: corrugated cardboard box with matte adhesive sticker. -->
<sdf version="1.6">
  <model name="robocon_tower_base_blue">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.01225</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.01225</iyy><iyz>0</iyz><izz>0.01225</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.35 0.35 0.35</size></box></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          <bounce><restitution_coefficient>0</restitution_coefficient></bounce>
        </surface>
      </collision>
      <visual name="matte_blue_sticker">
        <geometry><box><size>0.35 0.35 0.35</size></box></geometry>
        <material>
          <ambient>0.196078 0 1 1</ambient>
          <diffuse>0.196078 0 1 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
