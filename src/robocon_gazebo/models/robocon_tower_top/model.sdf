<?xml version="1.0"?>
<!-- Shared dynamic RC2027 tower top. The placement GUI spawns 12 instances with different poses. -->
<sdf version="1.6">
  <model name="robocon_tower_top">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.115</mass>
        <inertia>
          <ixx>0.000766667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000766667</iyy>
          <iyz>0</iyz>
          <izz>0.000766667</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.2 0.2 0.2</size></box>
        </geometry>
        <surface>
          <friction><ode><mu>0.65</mu><mu2>0.65</mu2></ode></friction>
          <contact><ode><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>

      <!-- Exactly two equal halves: no dark core, labels, or third colour. -->
      <visual name="red_half">
        <pose>0.05 0 0 0 0 0</pose>
        <geometry><box><size>0.1 0.2 0.2</size></box></geometry>
        <material>
          <ambient>0.9 0.02 0.02 1</ambient>
          <diffuse>0.9 0.02 0.02 1</diffuse>
        </material>
      </visual>
      <visual name="blue_half">
        <pose>-0.05 0 0 0 0 0</pose>
        <geometry><box><size>0.1 0.2 0.2</size></box></geometry>
        <material>
          <ambient>0.02 0.02 0.9 1</ambient>
          <diffuse>0.02 0.02 0.9 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
